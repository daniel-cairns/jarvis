{
  "name": "jarvis",
  "version": "0.1.0",
  "description": "A local voice assistant for macOS, built on the Claude Agent SDK, with REA for reverse-engineering teardowns.",
  "scripts": {
    "start": "sh scripts/astra.sh",
    "build:ax": "mkdir -p ${JARVIS_HOME:-$HOME/.jarvis}/bin && swiftc -O -swift-version 5 native/astra-ax.swift -o ${JARVIS_HOME:-$HOME/.jarvis}/bin/astra-ax",
    "text": "tsx src/index.ts --text",
    "pretext": "npm run -s build:orb",
    "build:orb": "esbuild orb/graph/graph-src.js --bundle --format=iife --minify --outfile=orb/build/graph.js --log-level=warning",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:orb": "npm run -s build:orb && node scripts/check-orb.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@huggingface/transformers": "^3.8.1",
    "3d-force-graph": "1.80.1",
    "electron": "^45.2.1",
    "kokoro-js": "^1.2.1",
    "marked": "18.1.1",
    "three": "0.186.1",
    "three-spritetext": "1.10.0",
    "tldts": "7.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "allowScripts": {
    "electron@45.2.1": true
  }
}
