# Copy to .env (or export in your shell). Every value here is optional.

# Claude credentials: either log in once with Claude Code (`claude` then /login), or set an API key.
# ANTHROPIC_API_KEY=

# Where Jarvis keeps things (default ~/.jarvis): brain/ for notes, workspace/ for apps it builds.
# JARVIS_HOME=~/.jarvis
# JARVIS_BRAIN_DIR=~/.jarvis/brain
# JARVIS_WORKSPACE_DIR=~/.jarvis/workspace

# Model and spend
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_EFFORT=high            # low | medium | high | xhigh | max
# JARVIS_MAX_BUDGET_USD=5       # hard cap per request

# Voice. List voices with: say -v '?'
# JARVIS_VOICE=Daniel
# JARVIS_SPEECH_RATE=190
# JARVIS_RECORDER_BIN=rec
# JARVIS_WHISPER_BIN=whisper-cli
# JARVIS_WHISPER_MODEL=~/.jarvis/models/ggml-base.en.bin

# REA MCP server command (default assumes `npm install -g rea-agents`)
# JARVIS_REA_COMMAND=rea mcp

# Clean browser for website teardowns
# JARVIS_CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# JARVIS_CHROME_DEBUG_PORT=9222
