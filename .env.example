# Copy to .env (or export in your shell). Every value here is optional.

# Claude credentials: either log in once with Claude Code (`claude` then /login), or set an API key.
# ANTHROPIC_API_KEY=

# Where Astra keeps things (default ~/.jarvis): brain/ for notes, workspace/ for apps it builds.
# JARVIS_HOME=~/.jarvis
# JARVIS_BRAIN_DIR=~/.jarvis/brain
# JARVIS_WORKSPACE_DIR=~/.jarvis/workspace

# Model and spend
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_EFFORT=high            # low | medium | high | xhigh | max

# Voice. Kokoro (local neural voice) by default. British: bf_emma, bf_isabella, bm_fable, bm_george; American: af_heart, am_michael.
# JARVIS_TTS=kokoro             # kokoro | say
# JARVIS_VOICE=bf_emma
# JARVIS_TTS_CACHE_DIR=~/.jarvis/models/tts
# Wake word: say "Astra" to make her listen (voice mode). The mic stays on while she runs; set off to disable.
# JARVIS_WAKE=on
# Seconds of quiet before Astra decides you've finished talking (longer = fewer cut-off sentences).
# JARVIS_PAUSE_SEC=2
# Microphone boost in dB (with a limiter) before speech detection. 0 turns it off; raise it if she misses you.
# JARVIS_MIC_GAIN_DB=18
# Longest one recording may run, in seconds. When to stop is otherwise set from the room's own noise level, measured
# as listening starts; this cap catches anything that still never goes quiet.
# JARVIS_MAX_LISTEN_SEC=45
# The speech detector that decides you've finished talking (Silero VAD, see README). Missing: the loudness fallback.
# JARVIS_VAD_MODEL=~/.jarvis/models/silero_vad.onnx
# The `say` fallback. List voices with: say -v '?'
# JARVIS_SAY_VOICE=Daniel
# JARVIS_SPEECH_RATE=190
# JARVIS_RECORDER_BIN=rec
# JARVIS_WHISPER_BIN=whisper-cli
# JARVIS_WHISPER_MODEL=~/.jarvis/models/ggml-base.en.bin

# REA MCP server command (default assumes `npm install -g rea-agents`)
# JARVIS_REA_COMMAND=rea mcp

# Clean browser for website teardowns
# JARVIS_CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# JARVIS_CHROME_DEBUG_PORT=9222

# Security check before Astra fetches a page. Quad9's threat DNS is always checked (no key). These two add more
# threat lists; both are free. Google: a Google Cloud project with the Safe Browsing API enabled, then an API key
# (non-commercial use). URLhaus: an abuse.ch Auth-Key from https://auth.abuse.ch/. Only the address without its
# query string is sent to them.
# JARVIS_SAFE_BROWSING_KEY=
# JARVIS_URLHAUS_KEY=
